DATABASE_URL="postgresql://trustchain:trustchain_secret@localhost:5432/trustchain?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate a random secret; the startup script does this for local development.
NEXTAUTH_SECRET=""
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="TrustChain <noreply@trustchain.local>"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Blockchain worker + web share this database and deployment file.
# CHAIN_RPC_URL is server-only. Never put an API-key RPC URL in NEXT_PUBLIC_*.
CHAIN_RPC_URL="http://127.0.0.1:8545"
# Optional; default is 0 on local Hardhat and 3 on Sepolia.
# CHAIN_CONFIRMATIONS="3"
IPFS_API_URL="http://127.0.0.1:5001"
IPFS_API_AUTHORIZATION=""
# Optional second Kubo node. Both pins must succeed before marking content ready.
IPFS_BACKUP_API_URL=""
IPFS_BACKUP_API_AUTHORIZATION=""
NEXT_PUBLIC_IPFS_GATEWAY="http://localhost:8080/ipfs/"
